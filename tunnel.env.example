# Runtime-only environment for a Base Sepolia Quick Tunnel demo.
# Copy to tunnel.env, fill the blanks, and never add wallet private keys.
SERVICE_MODE=pro
DATABASE_URL=
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_WS_URL=
SESSION_SECRET=

# Set this after cloudflared prints the generated public URL.
FRONTEND_ORIGIN=https://replace-me.trycloudflare.com

# Empty means same-origin /v1 and /health requests through Next.js rewrites.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_RPC_URL=
