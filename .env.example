# PostgreSQL is provided by the developer's existing local Docker container.
DATABASE_URL=

# Base Sepolia server-side RPC endpoints.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/cORsrX-lnpCIBxa1hvR5v
BASE_SEPOLIA_WS_URL=wss://base-sepolia.g.alchemy.com/v2/cORsrX-lnpCIBxa1hvR5v

# Contract deployment and smoke scripts. Keep the private key local only.
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_QUOTE_ADDRESS=
LAAS_TREASURY_ADDRESS=
START_TICK_TOKEN0_FRAME=
TICK_SPACING=60
BASE_SEPOLIA_REGISTRY_ADDRESS=
BASE_SEPOLIA_FACTORY_ADDRESS=

# Optional smoke-launch overrides.
# SMOKE_API_URL=https://api-demo.example.com
# SMOKE_AUTH_ORIGIN=https://demo.example.com
# SMOKE_KEYSTORE=/absolute/path/to/foundry-keystore
# SMOKE_KEYSTORE_PASSWORD_FILE=/absolute/path/to/password-file
# SMOKE_LAUNCHPAD_TREASURY=0x...
# SMOKE_REFERRER_ADDRESS=0x...
# SMOKE_LAUNCHPAD_SLUG=demo-pad
# SMOKE_TOKEN_NAME="O1 Demo Token"
# SMOKE_TOKEN_SYMBOL=O1DEMO
# SMOKE_TOKEN_URI=ipfs://o1-demo
# SMOKE_LAUNCH_SALT=0x...

# Generate a long random value locally. Never commit the real secret.
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:3000

# Browser-visible endpoints.
NEXT_PUBLIC_API_URL=http://localhost:8888
NEXT_PUBLIC_RPC_URL=
